{
  "expo": {
    "name": "PetPrep",
    "slug": "petprep",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "PetPrep reads only today's step count from Apple Health so your virtual dog gets its daily walk. Nothing else is read and nothing is written.",
        "NSMotionUsageDescription": "PetPrep counts your steps so your virtual dog gets its daily walk.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.datavallis.petprep"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7FE0B4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ],
      "usesCleartextTraffic": true,
      "package": "com.datavallis.petprep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F2"
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow PetPrep to access your Face ID for secure authentication."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1A7A55",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "sl"
            ],
            "android": [
              "en",
              "sl"
            ]
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthUpdateUsageDescription": "PetPrep never writes to Apple Health. It only reads today's step count so your virtual pet gets its daily walk; this permission is never requested.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "04c069be-7cf1-43df-98b9-58fd692a7be6"
      }
    },
    "owner": "petprep",
    "locales": {
      "sl": "./locales/sl.json"
    }
  }
}
