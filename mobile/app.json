{
  "expo": {
    "name": "PetPrep",
    "slug": "petprep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "PetPrep reads your step count to track your pet's daily walking goals.",
        "NSHealthUpdateUsageDescription": "PetPrep updates your step count to sync pet walking activity.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.datavallis.petprep"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "usesCleartextTraffic": true,
      "package": "com.datavallis.petprep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow PetPrep to access your Face ID for secure authentication."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "04c069be-7cf1-43df-98b9-58fd692a7be6"
      }
    },
    "owner": "petprep"
  }
}
