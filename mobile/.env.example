# Copy to mobile/.env (gitignored) for local work. Every variable is optional:
# unset → the production defaults in src/config/env.ts.

# API + realtime (local Sail: your Mac's LAN IP on a device, 10.0.2.2 on the Android emulator)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=
EXPO_PUBLIC_REVERB_SCHEME=

# RevenueCat public SDK keys (M3-07) — appl_… / goog_…, never the secret REST key.
# Unset → in-app purchases disabled (no SDK call, no network). Needs a dev build.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
