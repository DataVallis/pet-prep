# Copy to mobile/.env (gitignored) for local work. Every variable is optional:
# unset → the production defaults in src/config/env.ts.

# API + realtime (local Sail: your Mac's LAN IP on a device, 10.0.2.2 on the Android emulator)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=
EXPO_PUBLIC_REVERB_SCHEME=

# RevenueCat public SDK keys (M3-07) — appl_… / goog_…, never the secret REST key.
# Unset → in-app purchases disabled (no SDK call, no network). Needs a dev build.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Google sign-in for parents (M2-10c) — public OAuth client IDs, not secrets (also in eas.json
# for every build profile). Web client = the ID token's audience on iOS and Android; iOS
# client + its reversed URL scheme (added to Info.plist by the config plugin only when set).
# Missing → the "Continue with Google" button is hidden (iOS needs all three, Android the web
# ID). The Android OAuth client (1029107925972-42jsoh8vvtsjv4tk8398o4g1mrp94mib…) only has to
# exist in the Google Cloud project with the signing SHA-1 — the app never reads it.
# Apple sign-in needs no variable (iOS only, `expo-apple-authentication`). Dev build only.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1029107925972-jcets5rq4a03c00okr54e55jvluj2giv.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1029107925972-fm90sk3l07phkqbkfcnjli2jddp4bqfu.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1029107925972-fm90sk3l07phkqbkfcnjli2jddp4bqfu
