<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="PETPREP_CATS_ENABLED" value="false"/>
        <env name="AI_STATE_MEDIA_ENABLED" value="false"/>
        <!-- Clip quality check (David 2026-10-23): off for the suite (the old store-at-once path); MediaQualityCheckTest picks a mode with useQualityCheck(). -->
        <env name="AI_QUALITY_CHECK_MODE" value="off"/>
        <env name="PUSH_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- System health: capture off for the suite (its own tests switch it on), same connection so RefreshDatabase rolls it back. -->
        <env name="SYSTEM_HEALTH_CAPTURE" value="false"/>
        <env name="SYSTEM_HEALTH_ISOLATED_CONNECTION" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
