APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# System health (/admin/system-health): store reported errors in system_errors
# (false = off) and write them over a separate DB connection (survives rollbacks).
SYSTEM_HEALTH_CAPTURE=true
SYSTEM_HEALTH_ISOLATED_CONNECTION=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# fal.ai — empty key disables AI media generation. Webhooks are signature-verified (no secret).
FAL_AI_API_KEY=
# M5-T15: optional fal key with the billing:usage:read scope to read the account balance (empty → FAL_AI_API_KEY)
FAL_AI_BILLING_KEY=
# M5-T19: admin Discord channel webhook (secret) — AI budget / fal.ai balance warnings are also posted there; empty = off
DISCORD_ALERTS_WEBHOOK_URL=
# AI media (config/media.php): estimated spend caps (fail closed), model profiles, DNA version, AI Lab.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50
AI_BUDGET_TIMEZONE=UTC
AI_REFERENCE_IMAGE_PROFILE=nano_banana_pro
AI_STATE_VIDEO_PROFILE=kling_v3_pro
# M5-T08: state key image profile (Nano Banana Pro Edit).
AI_KEYFRAME_PROFILE=nano_banana_pro_edit
# M5-T08b: state media on / off is switched in /admin → Feature switches (app_settings.state_media);
# this env value is only the default while no row exists (default true).
# AI_STATE_MEDIA_ENABLED=true
# M5-T09 / T10: school & game phase clips — default only; switch in /admin → Feature switches (app_settings.phase_clips)
# AI_PHASE_CLIPS_ENABLED=true
# Clip quality check (David 2026-10-23): on / off in /admin → Feature switches (app_settings.quality_check);
# this env value is only the default. The AI vision part stays off until its price is verified.
# AI_QUALITY_CHECK_MODE=shadow   # off | shadow | enforce (default shadow until calibrated)
AI_QUALITY_VISION_ENABLED=false
AI_PET_DNA_VERSION=2
AI_LAB_ENABLED=true
AI_LAB_MAX_RUN_USD=3
AI_LAB_DAILY_USD=3
AI_LAB_MONTHLY_USD=30
# Pet media storage (M4-05): private disk + signed URLs for the apps.
# local (default) | s3 = private bucket below (M4-05; switch only after media:move-to-object-storage --verify)
PET_MEDIA_DISK=local
PET_MEDIA_S3_BUCKET=
PET_MEDIA_S3_KEY=
PET_MEDIA_S3_SECRET=
PET_MEDIA_S3_ENDPOINT=https://fsn1.your-objectstorage.com
PET_MEDIA_S3_REGION=fsn1
PET_MEDIA_S3_PATH_STYLE=false
PET_MEDIA_S3_PREFIX=pet-media
PET_MEDIA_S3_URL_TTL_SECONDS=300
PET_MEDIA_MAX_IMAGE_MB=25
PET_MEDIA_MAX_VIDEO_MB=60
PET_MEDIA_DOWNLOAD_TIMEOUT=60
PET_MEDIA_URL_TTL_MINUTES=60
# Default php (stream from PHP). Production gets caddy from compose.production.yaml (M4-05b) —
# do not copy an uncommented value into /opt/petprep/.env.
# PET_MEDIA_SERVE_VIA=php

# Legal texts accepted at parent sign-up (M2-10a). Bump when pogoji/zasebnost change.
LEGAL_TERMS_VERSION=draft-2026-10

# Parent sign-in with Google / Apple (M2-10c). Public identifiers, not secrets.
# Google OAuth client IDs (web, iOS, Android), comma-separated. Default when unset: PetPrep's own
# ids (config/services.php) — no server change needed. Set to an empty value to disable Google sign-in.
# GOOGLE_CLIENT_IDS=<web-id>.apps.googleusercontent.com,<ios-id>.apps.googleusercontent.com,<android-id>.apps.googleusercontent.com
# Accepted Apple `aud` values, comma-separated: the iOS bundle id (+ a Services ID for Android / web later).
# Default when unset: com.datavallis.petprep. Set to an empty value to disable Apple sign-in.
# APPLE_AUDIENCES=com.datavallis.petprep
# Apple token revocation on account deletion (App Store 5.1.1(v)). Team / key ids are public (defaults below).
# APPLE_TEAM_ID=4345XU4MU8
# APPLE_KEY_ID=Z8WR3WL68G
# Override only — client_id of the token / revoke calls. Unset = the aud of the Apple token used for the
# deletion's re-authentication, else com.datavallis.petprep.
# APPLE_CLIENT_ID=
# SECRET: the Sign in with Apple private key = base64 of the whole .p8 file on one line
# (base64 -i AuthKey_Z8WR3WL68G.p8 | tr -d '\n'); raw PEM with \n escapes also works.
# Empty = no revocation (logged; the deletion still succeeds).
APPLE_SIGN_IN_PRIVATE_KEY=

# RevenueCat (M3-08). The webhook fails closed: without a secret every call → 503.
# Set the same value as the webhook's Authorization header in RevenueCat ("Bearer <secret>").
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PUBLIC_KEY=
# M3-11: store product id(s) of the consumable 12-week challenge (comma-separated).
# REVENUECAT_CHALLENGE_PRODUCTS=petprep_challenge_12w
# M6-W02 »Želje«: wish store products as product_id:item_key pairs (comma-separated). Default = the six products below.
# REVENUECAT_WISH_PRODUCTS=petprep_wish_bed:bed,petprep_wish_bowls:bowls,petprep_wish_toy_1:toy_1,petprep_wish_toy_2:toy_2,petprep_wish_treats_10:treats,petprep_wish_bundle_welcome:welcome_bundle
# SANDBOX purchases create / revoke challenge credits? Default: true outside production, false in production.
# REVENUECAT_ACCEPT_SANDBOX=

# Push notifications (M3-02, config/push.php): Expo Push Service. true in production.
PUSH_ENABLED=false
# Optional expo.dev access token ("Enhanced push security"); empty = unauthenticated sends.
EXPO_ACCESS_TOKEN=
# PUSH_DEDUPE_MINUTES=30
# Cats (M5-R06-09): switched in /admin → Funkcije (off | test families | everyone, stored in
# app_settings). This env is only a backwards-compatible override: true = everyone, whatever
# the admin setting says. Leave false to let the admin switch decide (default: off).
PETPREP_CATS_ENABLED=false
